# FILE: /.env.example
# Copy to .env and adjust. Real environment variables override this file.

# Public base URL (used for webhook / API URLs shown in the UI)
APP_URL=http://localhost:8000
# true shows detailed errors - never enable in production
APP_DEBUG=false
# Secret used to encrypt channel credentials. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=change-me-to-a-long-random-string

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_whatsapp_bot
DB_USER=root
DB_PASS=

# Comma-separated IPs of reverse proxies / load balancers whose
# X-Forwarded-For header may be trusted (leave empty if none)
TRUSTED_PROXIES=

# Allow outgoing webhooks to private/internal addresses (development only)
WEBHOOK_ALLOW_PRIVATE=false

# Test runner database (must end with _test; it is dropped and re-created)
TEST_DB_NAME=ai_whatsapp_bot_test
